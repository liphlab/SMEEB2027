source 'https://rubygems.org'

# The 'github-pages' gem pins Jekyll and all plugins to exactly the versions
# GitHub Pages uses to build the site. This way, what you see in the local
# preview is what will appear online.
#
# Local preview:
#   bundle install                          (once)
#   bundle exec jekyll serve --baseurl ""   (then open http://localhost:4000)
gem 'github-pages', group: :jekyll_plugins

# Required on Ruby 3.x, no longer bundled with the standard library
gem 'webrick'
